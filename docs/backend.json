
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account in the system.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the user." },
        "role": { "type": "string", "description": "User's role (e.g., 'resident', 'agent')." },
        "name": { "type": "string", "description": "Full name of the user." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "unitId": { "type": "string", "description": "Associated unit ID, optional." }
      },
      "required": ["id", "role", "name", "email"]
    },
    "Unit": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Unit",
      "type": "object",
      "description": "Represents a physical unit within a site.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the unit." },
        "label": { "type": "string", "description": "Display label for the unit (e.g., 'Apt 101')." },
        "siteId": { "type": "string", "description": "Identifier for the site this unit belongs to." }
      },
      "required": ["id", "label", "siteId"]
    },
    "Pass": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Pass",
      "type": "object",
      "description": "Represents a visitor pass for accessing specific areas.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the pass." },
        "code": { "type": "string", "description": "The unique code for the pass (e.g., QR content)." },
        "areas": { "type": "array", "items": { "type": "string" }, "description": "Array of area IDs this pass grants access to." },
        "start": { "type": "string", "format": "date-time", "description": "Start validity time." },
        "end": { "type": "string", "format": "date-time", "description": "End validity time." },
        "status": { "type": "string", "description": "Status of the pass (e.g., 'active', 'expired')." },
        "unitId": { "type": "string", "description": "The unit that generated this pass." }
      },
      "required": ["id", "code", "areas", "start", "end", "status", "unitId"]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a booking for an amenity.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the booking." },
        "amenityId": { "type": "string", "description": "Reference to the booked amenity." },
        "slotStart": { "type": "string", "format": "date-time", "description": "Booking start time." },
        "slotEnd": { "type": "string", "format": "date-time", "description": "Booking end time." },
        "price": { "type": "number", "description": "Total price of the booking." },
        "status": { "type": "string", "description": "Status of the booking (e.g., 'confirmed', 'cancelled')." },
        "userId": { "type": "string", "description": "The user who made the booking." }
      },
      "required": ["id", "amenityId", "slotStart", "slotEnd", "price", "status", "userId"]
    },
    "Amenity": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Amenity",
      "type": "object",
      "description": "Represents a bookable amenity.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the amenity." },
        "name": { "type": "string", "description": "Name of the amenity." },
        "rules": { "type": "string", "description": "Usage rules and policies." },
        "priceRuleId": { "type": "string", "description": "Reference to a pricing rule." },
        "photos": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "URLs of amenity photos." }
      },
      "required": ["id", "name", "rules", "priceRuleId", "photos"]
    },
    "Invoice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Invoice",
      "type": "object",
      "description": "Represents a financial invoice for a user.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the invoice." },
        "userId": { "type": "string", "description": "The user associated with the invoice." },
        "amount": { "type": "number", "description": "Total amount due." },
        "due": { "type": "string", "format": "date-time", "description": "Due date for the payment." },
        "status": { "type": "string", "description": "Status of the invoice (e.g., 'paid', 'unpaid')." },
        "ledger": { "type": "array", "items": { "type": "string" }, "description": "Array of transaction IDs related to this invoice." }
      },
      "required": ["id", "userId", "amount", "due", "status", "ledger"]
    },
    "Ticket": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Ticket",
      "type": "object",
      "description": "Represents a maintenance or support ticket.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the ticket." },
        "unitId": { "type": "string", "description": "The unit associated with the ticket." },
        "category": { "type": "string", "description": "Category of the issue." },
        "desc": { "type": "string", "description": "Detailed description of the issue." },
        "media": { "type": "array", "items": { "type": "string" }, "description": "Attached media file identifiers." },
        "status": { "type": "string", "description": "Current status of the ticket." },
        "slaDeadline": { "type": "string", "format": "date-time", "description": "SLA deadline for resolution." },
        "timeline": { "type": "array", "items": { "type": "string" }, "description": "Timeline of events for the ticket." },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"], "description": "Severity of the ticket" }
      },
      "required": ["id", "unitId", "category", "desc", "status", "slaDeadline", "timeline"]
    },
    "Door": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Door",
      "type": "object",
      "description": "Represents a door with access control.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the door." },
        "name": { "type": "string", "description": "Name of the door." },
        "state": { "type": "string", "description": "Current state (e.g., 'locked', 'unlocked')." },
        "proximityReady": { "type": "boolean", "description": "Indicates if proximity open is available." },
        "siteId": { "type": "string", "description": "The site this door belongs to." }
      },
      "required": ["id", "name", "state", "proximityReady", "siteId"]
    },
    "AccessLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AccessLog",
      "type": "object",
      "description": "Represents a log of an access attempt.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the log entry." },
        "ts": { "type": "string", "format": "date-time", "description": "Timestamp of the access attempt." },
        "doorId": { "type": "string", "description": "Identifier of the door that was accessed." },
        "result": { "type": "string", "description": "Result of the access attempt (e.g., 'granted', 'denied')." }
      },
      "required": ["id", "ts", "doorId", "result"]
    },
    "Incident": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Incident",
      "type": "object",
      "description": "Represents a security or operational incident.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the incident." },
        "severity": { "type": "string", "description": "Severity of the incident." },
        "status": { "type": "string", "description": "Current status of the incident." },
        "slaDeadline": { "type": "string", "format": "date-time", "description": "SLA for incident resolution." },
        "evidence": { "type": "array", "items": { "type": "string" }, "description": "Array of evidence file identifiers." },
        "relatedIds": { "type": "array", "items": { "type": "string" }, "description": "IDs of related entities." }
      },
      "required": ["id", "severity", "status", "slaDeadline", "evidence"]
    },
    "Energy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Energy",
      "type": "object",
      "description": "Represents energy consumption data.",
      "properties": {
        "siteId": { "type": "string", "description": "The site this data belongs to." },
        "ts": { "type": "string", "format": "date-time", "description": "Timestamp of the data point." },
        "kwh": { "type": "number", "description": "Energy consumption in kWh." },
        "waterL": { "type": "number", "description": "Water consumption in liters." },
        "iaqIndex": { "type": "number", "description": "Indoor Air Quality Index." },
        "zone": { "type": "string", "description": "Specific zone within the site." }
      },
      "required": ["siteId", "ts", "kwh", "waterL", "iaqIndex", "zone"]
    },
    "EVSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "EVSession",
      "type": "object",
      "description": "Represents an EV charging session.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the session." },
        "bayId": { "type": "string", "description": "The charging bay used." },
        "userId": { "type": "string", "description": "The user who started the session." },
        "kwh": { "type": "number", "description": "Energy delivered in kWh." },
        "cost": { "type": "number", "description": "Total cost of the session." },
        "status": { "type": "string", "description": "Status of the session (e.g., 'charging', 'completed')." },
        "startedAt": { "type": "string", "format": "date-time", "description": "Session start time." },
        "endedAt": { "type": "string", "format": "date-time", "description": "Session end time, optional." }
      },
      "required": ["id", "bayId", "userId", "kwh", "cost", "status", "startedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/entities/User" }, "description": "Stores user profiles." }
      },
      {
        "path": "/units/{unitId}",
        "definition": { "entityName": "Unit", "schema": { "$ref": "#/entities/Unit" }, "description": "Stores building unit information." }
      },
      {
        "path": "/passes/{passId}",
        "definition": { "entityName": "Pass", "schema": { "$ref": "#/entities/Pass" }, "description": "Stores visitor passes." }
      },
      {
        "path": "/bookings/{bookingId}",
        "definition": { "entityName": "Booking", "schema": { "$ref": "#/entities/Booking" }, "description": "Stores amenity bookings." }
      },
      {
        "path": "/amenities/{amenityId}",
        "definition": { "entityName": "Amenity", "schema": { "$ref": "#/entities/Amenity" }, "description": "Stores bookable amenities." }
      },
      {
        "path": "/invoices/{invoiceId}",
        "definition": { "entityName": "Invoice", "schema": { "$ref": "#/entities/Invoice" }, "description": "Stores user invoices." }
      },
      {
        "path": "/tickets/{ticketId}",
        "definition": { "entityName": "Ticket", "schema": { "$ref": "#/entities/Ticket" }, "description": "Stores maintenance and support tickets." }
      },
      {
        "path": "/doors/{doorId}",
        "definition": { "entityName": "Door", "schema": { "$ref": "#/entities/Door" }, "description": "Stores information about access-controlled doors." }
      },
      {
        "path": "/accessLogs/{logId}",
        "definition": { "entityName": "AccessLog", "schema": { "$ref": "#/entities/AccessLog" }, "description": "Logs of access attempts." }
      },
      {
        "path": "/incidents/{incidentId}",
        "definition": { "entityName": "Incident", "schema": { "$ref": "#/entities/Incident" }, "description": "Stores security and operational incidents." }
      },
      {
        "path": "/energy/{energyId}",
        "definition": { "entityName": "Energy", "schema": { "$ref": "#/entities/Energy" }, "description": "Stores energy consumption data." }
      },
      {
        "path": "/evSessions/{sessionId}",
        "definition": { "entityName": "EVSession", "schema": { "$ref": "#/entities/EVSession" }, "description": "Stores EV charging sessions." }
      }
    ]
  }
}

    