/**
 * @fileoverview Firestore Security Rules for Veralogix SecureConnect application.
 *
 * Core Philosophy:
 * This ruleset implements a role-based access control (RBAC) model combined with
 * user-specific data segregation.  Authorization independence is achieved by denormalizing
 * data where necessary, specifically storing user roles directly under the user document
 * to avoid expensive `get()` operations in security rules.
 *
 * Data Structure:
 * - `/themes/{themeId}`: Stores application themes. Public read access, owner-only writes.
 * - `/templates/{templateId}`: Stores UI templates associated with themes. Public read access, owner-only writes.
 * - `/roles/{roleId}`: Stores role definitions. Public read access, owner-only writes.
 * - `/users/{userId}/roles/{roleId}`: Stores roles assigned to specific users.  Owner-only access.
 *
 * Key Security Decisions:
 * - Themes, templates, and roles are publicly readable to facilitate easy access and discovery within the application, but only owners can create, update, or delete them.
 * - User-specific roles under `/users/{userId}/roles/{roleId}` are strictly controlled by the owning user.
 * - No user listing is allowed, as it's not a required feature and could expose sensitive information.
 *
 * Denormalization for Authorization:
 * - Template documents contain a `themeId` field, allowing rules to directly reference the associated theme without requiring a `get()` operation.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the themes collection. Themes are publicly readable but only authorized users can modify them.
     * @path /themes/{themeId}
     * @allow (get, list): Any user can read themes.
     * @allow (create): Only the theme's creator can create a theme, with the 'id' field matching the user's ID.
     * @allow (update, delete): Only the theme's creator can modify or delete a theme.
     * @deny (create): A user attempts to create a theme with an 'id' field that doesn't match their user ID.
     * @principle Allows public read access while restricting write access to the theme creator.
     */
    match /themes/{themeId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to the templates collection. Templates are publicly readable but only authorized users can modify them.
     * @path /templates/{templateId}
     * @allow (get, list): Any user can read templates.
     * @allow (create): Only the template's creator can create a template.
     * @allow (update, delete): Only the template's creator can modify or delete a template.
     * @deny (create): A user attempts to create a template without proper authorization.
     * @principle Allows public read access while restricting write access to the template creator.
     */
    match /templates/{templateId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to the roles collection. Roles are publicly readable but only authorized users can modify them.
     * @path /roles/{roleId}
     * @allow (get, list): Any user can read roles.
     * @allow (create): Only the role's creator can create a role.
     * @allow (update, delete): Only the role's creator can modify or delete a role.
     * @deny (create): A user attempts to create a role without proper authorization.
     * @principle Allows public read access while restricting write access to the role creator.
     */
    match /roles/{roleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Controls access to the roles subcollection for each user. Only the owning user can manage their own roles.
     * @path /users/{userId}/roles/{roleId}
     * @allow (get, list, create, update, delete): Only the user who owns the document can read, write, update, and delete it.
     * @deny (get, list, create, update, delete): Another user tries to access this document.
     * @principle Enforces strict document ownership for writes.
     */
    match /users/{userId}/roles/{roleId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }

  /**
   * @description Checks if the user is signed in.
   * @param {}
   * @return {bool}
   */
  function isSignedIn() {
    return request.auth != null;
  }

  /**
   * @description Checks if the user is the owner of the document.
   * @param {string} userId The user ID to compare against the request's auth UID.
   * @return {bool}
   */
  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}