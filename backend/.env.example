NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://secureconnect:secureconnect@localhost:5432/secureconnect
REDIS_URL=redis://localhost:6379

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=secureconnect
KEYCLOAK_CLIENT_ID=secureconnect-api
KEYCLOAK_CLIENT_SECRET=change-me-api-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master

# Public web client (PKCE)
KEYCLOAK_WEB_CLIENT_ID=secureconnect-web

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=secureconnect
STORAGE_QUOTA_BYTES=1073741824

# SMTP (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@secureconnect.local

# CORS / security
CORS_ORIGINS=http://localhost:9002,http://localhost:3000
JWT_CLOCK_TOLERANCE_SEC=30
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Dev only — never enable in production
DEV_AUTH_BYPASS=false
DEV_BYPASS_USER_ID=
DEV_BYPASS_EMAIL=admin@veralogix.com
DEV_BYPASS_ROLES=admin,agent
